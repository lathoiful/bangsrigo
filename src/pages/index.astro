---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.svg';
import { supabase } from '../lib/supabase';

// Interface sesuai skema database "menus"
interface MenuItemDB {
  id: number;
  created_at: string;
  slug: string;
  name: string;
  description: string;
  subdescription?: string;
  price: string | number;
  image: string;
  badge?: string | null;
  addons: string | any[];
  category: string;
  spice_levels: string | number[];
}

// Fetch data dari Supabase
const [categoriesResponse, menusResponse] = await Promise.all([
  supabase.from('categories').select('*').order('id', { ascending: true }),
  supabase.from('menus').select('*').order('created_at', { ascending: false })
]);

const categoriesFromDb = categoriesResponse.data || [];
const rawMenus: MenuItemDB[] = menusResponse.data || [];

// Format & parse item menu dari DB
const menus = rawMenus.map((item) => {
  let parsedAddons = [];
  let parsedSpiceLevels = [];

  try {
    parsedAddons = typeof item.addons === 'string' ? JSON.parse(item.addons) : item.addons || [];
  } catch (e) {
    parsedAddons = [];
  }

  try {
    parsedSpiceLevels = typeof item.spice_levels === 'string' ? JSON.parse(item.spice_levels) : item.spice_levels || [];
  } catch (e) {
    parsedSpiceLevels = [];
  }

  return {
    ...item,
    priceNumber: Number(item.price) || 0,
    parsedAddons,
    parsedSpiceLevels
  };
});

// Menyusun kategori default (semua) + dari DB atau statis makanan/minuman
const categories = [
  { id: 'all', name: 'Semua' },
  { id: 'makanan', name: 'Makanan' },
  { id: 'minuman', name: 'Minuman' }
];

const formatRupiah = (price: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(price).replace('Rp', 'Rp ');
};
---

<Layout>
  <main class="w-full max-w-md mx-auto bg-slate-50 relative flex flex-col min-h-screen">
    <div class="bg-white">
      <!-- HEADER (Logo SVG) -->
      <header class="px-4 py-2 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <img src={logo.src} alt="BangsriGo Logo" class="h-20 w-auto object-contain" />
        </div>
      </header>

      <!-- SEARCH BAR -->
      <section class="px-4 py-2">
        <div class="relative flex items-center">
          <svg class="w-5 h-5 absolute left-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            id="search-input"
            type="text" 
            placeholder="Cari makanan atau minuman..." 
            class="w-full bg-[#F8F8F8] border border-slate-200/80 rounded-xl py-2.5 pl-10 pr-4 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-[#16A34A] focus:bg-white transition"
          />
        </div>
      </section>

      <!-- KATEGORI -->
      <section class="mt-2 pb-3">
        <div class="flex items-center gap-3 overflow-x-auto no-scrollbar px-4 py-1" id="category-container">
          {categories.map((cat, index) => (
            <button 
              type="button"
              data-category={cat.id}
              class={`category-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap cursor-pointer transition-all ${
                index === 0 
                  ? 'bg-[#16A34A] text-white shadow-xs' 
                  : 'bg-[#F8F8F8] text-slate-600 border border-slate-200/60 hover:bg-slate-100'
              }`}
            >
              {cat.name}
            </button>
          ))}
        </div>
      </section>
    </div>

    <!-- MAIN LIST (pb-24 disesuaikan agar tinggi scroll pas di atas keranjang) -->
    <div class="flex-1 px-4 py-4 space-y-4 pb-24">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-bold text-slate-900 text-base flex items-center gap-1.5">
            Daftar Menu
          </h2>
          <p class="text-xs text-slate-500">Pilih menu favoritmu di sini</p>
        </div>
      </div>

      <!-- DAFTAR MENU (2 Kolom) -->
      <div class="grid grid-cols-2 gap-3 mt-3" id="menu-grid">
        {menus.length === 0 ? (
          <p class="col-span-2 text-center text-sm text-slate-500 py-6">Belum ada menu yang tersedia.</p>
        ) : (
          menus.map((item) => (
            <div 
              class="menu-item bg-white border border-slate-100 rounded-2xl p-2 flex flex-col gap-2 shadow-xs hover:border-slate-200 transition group relative"
              data-category={item.category}
              data-name={item.name.toLowerCase()}
            >
              <a href={`/menu/${item.slug || item.id}`} class="contents">
                <!-- Foto Makanan -->
                <div class="relative w-full h-28 shrink-0 overflow-hidden rounded-xl">
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    class="w-full h-full object-cover bg-slate-100 group-hover:scale-105 transition duration-300"
                  />
                </div>

                <!-- Detail Makanan -->
                <div class="flex-1 flex flex-col min-w-0">
                  <h3 class="font-bold text-slate-900 text-sm truncate group-hover:text-[#16A34A] transition">{item.name}</h3>
                  <p class="text-[11px] text-slate-500 truncate mt-0.5" title={item.description}>{item.description}</p>
                </div>
              </a>

              <div class="mt-auto pt-2 flex items-end justify-between">
                <div>
                  <div class="font-bold text-slate-900 text-[13px]">{formatRupiah(item.priceNumber)}</div>
                  {item.parsedSpiceLevels && item.parsedSpiceLevels.length > 0 && (
                    <div class="flex items-center gap-1 text-[10px] text-amber-600 font-medium mt-0.5">
                      <span>🌶️ Level {Math.min(...item.parsedSpiceLevels)}-{Math.max(...item.parsedSpiceLevels)}</span>
                    </div>
                  )}
                </div>

                <!-- Button Tambah ke Keranjang -->
                <button 
                  type="button" 
                  aria-label={`Tambah ${item.name} ke keranjang`}
                  class="btn-add-cart w-9 h-9 rounded-xl bg-gradient-to-br from-[#16A34A] to-emerald-600 text-white flex items-center justify-center hover:from-emerald-600 hover:to-emerald-700 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 active:scale-95 shadow-sm cursor-pointer z-10"
                  data-id={item.id}
                  data-name={item.name}
                  data-price={item.priceNumber}
                  data-image={item.image}
                  data-has-spicy={item.parsedSpiceLevels.length > 0 ? 'true' : 'false'}
                >
                  <svg class="w-5 h-5 drop-shadow-sm pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            </div>
          ))
        )}
      </div>
      <div id="no-result" class="hidden col-span-2 text-center text-sm text-slate-500 py-6">Menu tidak ditemukan.</div>
    </div>

    <!-- FLOATING CART (Posisi fixed di atas safe area navigasi HP) -->
    <div 
      id="floating-cart" 
      class="fixed bottom-4 left-1/2 -translate-x-1/2 w-full max-w-md px-4 z-40 pb-[env(safe-area-inset-bottom)] hidden pointer-events-auto"
    >
      <a href="/cart" class="bg-[#16A34A] text-white rounded-xl p-3.5 flex items-center justify-between shadow-xl shadow-emerald-900/20 cursor-pointer hover:bg-emerald-700 transition">
        <div class="flex items-center gap-3">
          <div class="relative">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
            </svg>
            <span id="cart-badge" class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center border border-white">
              0
            </span>
          </div>

          <div>
            <div id="cart-summary" class="text-xs font-semibold leading-tight">0 Item • Rp 0</div>
            <div class="text-[11px] text-emerald-100 font-normal">Lihat Keranjang</div>
          </div>
        </div>

        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </main>
</Layout>

<!-- SCRIPT LOGIKA FILTER & CARTS -->
<script>
  interface AddonItem {
    name: string;
    price: number;
  }

  interface CartItem {
    cartItemId: string;
    id: string | number;
    menuId?: string | number;
    name: string;
    price: number;
    basePrice?: number;
    image: string;
    qty: number;
    quantity?: number;
    addons?: AddonItem[];
    notes?: string;
    spicyLevel?: string;
    totalPrice?: number;
  }

  const STORAGE_KEY = 'bangsri_cart';

  function formatRupiah(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    }).format(price).replace('Rp', 'Rp ');
  }

  function getCart(): CartItem[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
  }

  function calculateItemTotal(item: CartItem): number {
    const qty = item.qty || item.quantity || 1;
    const base = item.price || item.basePrice || 0;
    const addonsTotal = (item.addons || []).reduce((sum, addon) => sum + addon.price, 0);
    return (base + addonsTotal) * qty;
  }

  function updateCartUI() {
    const cart = getCart();
    const floatingCart = document.getElementById('floating-cart');
    const cartBadge = document.getElementById('cart-badge');
    const cartSummary = document.getElementById('cart-summary');

    if (!floatingCart || !cartBadge || !cartSummary) return;

    const totalQty = cart.reduce((sum, item) => sum + (item.qty || item.quantity || 0), 0);
    const totalPrice = cart.reduce((sum, item) => sum + calculateItemTotal(item), 0);

    if (totalQty > 0) {
      floatingCart.classList.remove('hidden');
      cartBadge.textContent = totalQty.toString();
      cartSummary.textContent = `${totalQty} Item • ${formatRupiah(totalPrice)}`;
    } else {
      floatingCart.classList.add('hidden');
    }
  }

  function addToCart(btn: HTMLButtonElement) {
    const id = btn.dataset.id || '';
    const name = btn.dataset.name || '';
    const price = Number(btn.dataset.price || 0);
    const image = btn.dataset.image || '';
    const hasSpicy = btn.dataset.hasSpicy === 'true';

    if (!id) return;

    const cart = getCart();
    const defaultSpicy = hasSpicy ? '1' : undefined;

    const existingIndex = cart.findIndex((item) => {
      const itemId = item.id || item.menuId;
      const hasNoAddons = !item.addons || item.addons.length === 0;
      const hasNoNotes = !item.notes;
      const sameSpicy = item.spicyLevel === defaultSpicy;
      return String(itemId) === String(id) && hasNoAddons && hasNoNotes && sameSpicy;
    });

    if (existingIndex > -1) {
      const item = cart[existingIndex];
      const currentQty = item.qty || item.quantity || 1;
      item.qty = currentQty + 1;
      item.quantity = item.qty;
    } else {
      cart.push({
        cartItemId: `${id}_basic_${Date.now()}`,
        id: id,
        menuId: id,
        name,
        price,
        basePrice: price,
        image,
        qty: 1,
        quantity: 1,
        addons: [],
        notes: '',
        spicyLevel: defaultSpicy
      });
    }

    saveCart(cart);
    updateCartUI();

    btn.classList.add('scale-125');
    setTimeout(() => btn.classList.remove('scale-125'), 150);
  }

  // Logika Filter Kategori & Search
  function initFilter() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const categoryButtons = document.querySelectorAll('.category-btn');
    const menuItems = document.querySelectorAll('.menu-item');
    const noResult = document.getElementById('no-result');

    let currentCategory = 'all';
    let searchQuery = '';

    function filterMenus() {
      let visibleCount = 0;
      menuItems.forEach((el) => {
        const item = el as HTMLElement;
        const category = item.dataset.category || '';
        const name = item.dataset.name || '';

        const matchesCategory = currentCategory === 'all' || category.toLowerCase() === currentCategory.toLowerCase();
        const matchesSearch = name.includes(searchQuery.toLowerCase());

        if (matchesCategory && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResult) {
        if (visibleCount === 0) {
          noResult.classList.remove('hidden');
        } else {
          noResult.classList.add('hidden');
        }
      }
    }

    categoryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryButtons.forEach((b) => {
          b.classList.remove('bg-[#16A34A]', 'text-white', 'shadow-xs');
          b.classList.add('bg-[#F8F8F8]', 'text-slate-600', 'border', 'border-slate-200/60', 'hover:bg-slate-100');
        });
        btn.classList.remove('bg-[#F8F8F8]', 'text-slate-600', 'border', 'border-slate-200/60', 'hover:bg-slate-100');
        btn.classList.add('bg-[#16A34A]', 'text-white', 'shadow-xs');

        currentCategory = (btn as HTMLElement).dataset.category || 'all';
        filterMenus();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim();
        filterMenus();
      });
    }
  }

  function init() {
    updateCartUI();
    initFilter();

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('.btn-add-cart') as HTMLButtonElement;

      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        addToCart(btn);
      }
    });

    window.addEventListener('storage', updateCartUI);
    window.addEventListener('cart-updated', updateCartUI);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>