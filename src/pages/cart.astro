---
import Layout from '../layouts/Layout.astro';
import { Icon } from "astro-icon/components";

// =========================================================================
// OPSI ATUR JARAK CARA A (via Tailwind Arbitrary Value / Pixel):
// Anda bisa ganti angka '160px' di bawah dengan angka berapa saja (misal: '100px', '200px', '250px')
// =========================================================================
const JARA_BAWAH = "pb-[160px]"; 
---

<Layout title="Keranjang Belanja - BangsriGo">
  <!-- 
    OPSI ATUR JARAK CARA B (via Inline CSS Variable):
    Ganti nilai `--jarak-bawah: 160px;` di bawah ini jika ingin atur langsung via CSS!
  -->
  <main 
    style="--jarak-bawah: 20px;" 
    class="w-full max-w-md mx-auto bg-slate-50 relative flex flex-col h-[calc(100vh-64px)] overflow-hidden"
  >
    
    <!-- ================= HEADER SECTION (TETAP DIAM DI ATAS) ================= -->
    <header class="bg-white border-b border-slate-200/80 px-4 h-14 flex items-center justify-between shadow-xs w-full flex-shrink-0 z-50">
      <a 
        href="/" 
        aria-label="Kembali" 
        class="w-9 h-9 flex items-center justify-center text-slate-700 hover:text-slate-900 bg-slate-100/80 hover:bg-slate-200/80 active:scale-95 rounded-full transition-all"
      >
        <Icon name="lucide:chevron-left" class="w-5 h-5 -ml-0.5" />
      </a>

      <div class="flex flex-col items-center justify-center text-center">
        <h1 class="text-sm font-bold text-slate-900 tracking-tight leading-tight">
          Keranjang Belanja
        </h1>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="header-item-count" class="text-[10px] font-medium text-slate-500">0 Item</span>
        </div>
      </div>

      <button 
        id="btn-clear-cart" 
        aria-label="Hapus Keranjang" 
        class="w-9 h-9 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 active:scale-95 rounded-full transition-all cursor-pointer"
      >
        <Icon name="lucide:trash-2" class="w-4 h-4" />
      </button>
    </header>

    <!-- ================= MAIN CONTENT SECTION (DENGAN KONTROL JARAK BAWAH) ================= -->
    <!-- 
      Jarak bawah dikontrol oleh 'style="padding-bottom: var(--jarak-bawah)"' 
      atau bisa diganti dengan variabel Astro '${JARA_BAWAH}' pada class.
    -->
    <div 
      style="padding-bottom: var(--jarak-bawah);" 
      class={`flex-1 w-full p-4 space-y-4 overflow-y-auto ${JARA_BAWAH}`}
    >
      
      <!-- DAFTAR MENU CONTAINER -->
      <div id="cart-items-container" class="space-y-3">
        <!-- Dinamis dirender via script dari localStorage -->
      </div>

      <!-- ================= RINGKASAN PEMBAYARAN & SECTION AKHIR ================= -->
      <section id="summary-section" class="bg-white rounded-2xl p-4 sm:p-5 border border-[#E5E7EB] shadow-xs space-y-4 hidden">
        <div class="flex items-center gap-2 pb-2.5 border-b border-slate-100">
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-[#0E9F3E] flex items-center justify-center">
            <Icon name="lucide:receipt" class="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-[#111827]">
            Ringkasan Pembayaran
          </h3>
        </div>

        <div class="space-y-2 text-xs sm:text-sm text-[#6B7280]">
          <div class="flex justify-between items-center">
            <span>Subtotal</span>
            <span id="summary-subtotal" class="font-medium text-[#111827]">Rp 0</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="flex items-center gap-1.5">
              Ongkir 
              <span class="text-[9px] bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded font-medium border border-amber-200/50">Info WA</span>
            </span>
            <span class="font-medium text-[#111827]">Rp 0 - 5.000</span>
          </div>
        </div>

        <div class="border-t border-[#E5E7EB] pt-3.5 flex justify-between items-center">
          <span class="text-xs sm:text-sm font-bold text-[#111827]">Total Sementara</span>
          <span id="summary-total" class="text-base sm:text-lg font-bold text-[#0E9F3E]">Rp 0</span>
        </div>

        <!-- Tombol Lanjutkan Konfirmasi (Section Terakhir) -->
        <div class="pt-2">
          <a
            href="/konfirmasi"
            id="btn-checkout"
            class="w-full h-[50px] bg-[#0E9F3E] hover:bg-[#0c8a36] active:scale-[0.98] text-white font-semibold rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all cursor-pointer no-underline text-sm sm:text-base"
          >
            <span>Lanjutkan ke Konfirmasi</span>
            <Icon name="lucide:arrow-right" class="w-5 h-5" />
          </a>
        </div>
      </section>

      <!-- ================= EMPTY STATE ================= -->
      <div id="empty-state" class="bg-white rounded-2xl p-8 border border-[#E5E7EB] shadow-xs text-center py-12 my-4 space-y-4 hidden">
        <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mx-auto text-[#0E9F3E]">
          <Icon name="lucide:shopping-bag" class="w-8 h-8" />
        </div>
        <div>
          <h2 class="text-lg font-bold text-[#111827]">
            Keranjang masih kosong
          </h2>
          <p class="text-xs sm:text-sm text-[#6B7280] mt-1">
            Yuk pilih makanan favoritmu terlebih dahulu.
          </p>
        </div>
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 bg-[#0E9F3E] text-white font-semibold text-xs sm:text-sm rounded-xl hover:bg-[#0c8a36] transition-colors"
        >
          Kembali ke Beranda
        </a>
      </div>

    </div>

  </main>
</Layout>

<script>
  interface AddonItem {
    name: string;
    price: number;
  }

  interface CartItem {
    cartItemId: string;
    id: string | number;
    menuId?: string | number;
    slug?: string;
    name: string;
    price: number;
    basePrice?: number;
    image: string;
    qty: number;
    quantity?: number;
    addons?: AddonItem[];
    notes?: string;
    spicyLevel?: string;
  }

  const STORAGE_KEY = 'bangsri_cart';

  function formatRupiah(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    }).format(price).replace('Rp', 'Rp ');
  }

  function getCart(): CartItem[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
  }

  function calculateItemTotal(item: CartItem): number {
    const qty = item.qty || item.quantity || 1;
    const base = item.price || item.basePrice || 0;
    const addonsTotal = (item.addons || []).reduce((sum, addon) => sum + addon.price, 0);
    return (base + addonsTotal) * qty;
  }

  function renderCart() {
    const cart = getCart();
    const container = document.getElementById('cart-items-container');
    const summarySection = document.getElementById('summary-section');
    const emptyState = document.getElementById('empty-state');
    const itemCountEl = document.getElementById('header-item-count');

    if (!container || !summarySection || !emptyState) return;

    const totalQty = cart.reduce((sum, item) => sum + (item.qty || item.quantity || 1), 0);
    if (itemCountEl) {
      itemCountEl.textContent = `${totalQty} Item`;
    }

    if (cart.length === 0) {
      container.innerHTML = '';
      summarySection.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    summarySection.classList.remove('hidden');

    let subtotal = 0;

    container.innerHTML = cart.map((item, index) => {
      const qty = item.qty || item.quantity || 1;
      const itemTotal = calculateItemTotal(item);
      subtotal += itemTotal;

      let detailsHtml = '';
      if (item.spicyLevel) {
        detailsHtml += `<p class="text-[11px] text-amber-600 font-medium">🌶️ Level ${item.spicyLevel}</p>`;
      }
      if (item.addons && item.addons.length > 0) {
        item.addons.forEach(addon => {
          detailsHtml += `<p class="text-[11px] text-[#6B7280]">+ ${addon.name}</p>`;
        });
      }
      if (!item.spicyLevel && (!item.addons || item.addons.length === 0)) {
        detailsHtml += `<p class="text-[11px] text-[#6B7280]">Tanpa Add-on</p>`;
      }

      const cartItemId = item.cartItemId || `${item.id || item.menuId || index}`;
      const productPath = item.slug || item.id || item.menuId || '';

      return `
        <div class="bg-white rounded-2xl p-4 border border-[#E5E7EB] shadow-xs flex flex-col gap-3 relative" data-cart-item-id="${cartItemId}">
          
          <button
            type="button"
            class="btn-delete-item absolute top-3 right-3 text-slate-400 hover:text-red-500 p-1.5 rounded-lg transition-colors cursor-pointer"
            data-cart-item-id="${cartItemId}"
            aria-label="Hapus produk ini"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
          </button>

          <a href="/menu/${productPath}" class="flex gap-3 pr-6 group no-underline">
            <img
              src="${item.image || 'https://placehold.co/120x120'}"
              alt="${item.name}"
              class="w-[72px] h-[72px] object-cover rounded-xl flex-shrink-0 bg-slate-100 group-hover:opacity-90 transition-opacity"
            />
            <div class="flex-1 min-w-0">
              <h2 class="text-sm font-semibold text-[#111827] truncate group-hover:text-[#0E9F3E] transition-colors">
                ${item.name}
              </h2>
              <div class="text-xs text-[#6B7280] mt-0.5 space-y-0.5">
                ${detailsHtml}
              </div>
            </div>
          </a>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <div class="flex items-center gap-2.5">
              <button
                type="button"
                class="btn-decrease w-7 h-7 rounded-lg border border-[#E5E7EB] flex items-center justify-center text-[#111827] hover:bg-slate-50 active:bg-slate-100 font-medium transition-colors cursor-pointer text-xs"
                data-cart-item-id="${cartItemId}"
                aria-label="Kurangi jumlah"
              >
                -
              </button>
              <span class="text-xs font-semibold text-[#111827] min-w-[16px] text-center">
                ${qty}
              </span>
              <button
                type="button"
                class="btn-increase w-7 h-7 rounded-lg border border-[#E5E7EB] flex items-center justify-center text-[#111827] hover:bg-slate-50 active:bg-slate-100 font-medium transition-colors cursor-pointer text-xs"
                data-cart-item-id="${cartItemId}"
                aria-label="Tambah jumlah"
              >
                +
              </button>
            </div>

            <span class="text-xs sm:text-sm font-bold text-[#111827]">
              ${formatRupiah(itemTotal)}
            </span>
          </div>
        </div>
      `;
    }).join('');

    const subtotalEl = document.getElementById('summary-subtotal');
    const totalEl = document.getElementById('summary-total');

    if (subtotalEl) subtotalEl.textContent = formatRupiah(subtotal);
    if (totalEl) totalEl.textContent = formatRupiah(subtotal);
  }

  function handleQuantityChange(cartItemId: string, change: number) {
    const cart = getCart();
    const itemIndex = cart.findIndex(i => String(i.cartItemId || i.id || i.menuId) === String(cartItemId));

    if (itemIndex > -1) {
      const currentQty = cart[itemIndex].qty || cart[itemIndex].quantity || 1;
      const newQty = currentQty + change;

      if (newQty > 0) {
        cart[itemIndex].qty = newQty;
        cart[itemIndex].quantity = newQty;
      } else {
        cart.splice(itemIndex, 1);
      }

      saveCart(cart);
      renderCart();
    }
  }

  function handleRemoveItem(cartItemId: string) {
    let cart = getCart();
    cart = cart.filter(i => String(i.cartItemId || i.id || i.menuId) !== String(cartItemId));
    saveCart(cart);
    renderCart();
  }

  function clearCart() {
    if (confirm('Apakah Anda yakin ingin mengosongkan keranjang?')) {
      localStorage.removeItem(STORAGE_KEY);
      renderCart();
      window.dispatchEvent(new Event('cart-updated'));
    }
  }

  function init() {
    renderCart();

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const incBtn = target.closest('.btn-increase') as HTMLButtonElement;
      if (incBtn) {
        const id = incBtn.dataset.cartItemId;
        if (id) handleQuantityChange(id, 1);
      }

      const decBtn = target.closest('.btn-decrease') as HTMLButtonElement;
      if (decBtn) {
        const id = decBtn.dataset.cartItemId;
        if (id) handleQuantityChange(id, -1);
      }

      const delBtn = target.closest('.btn-delete-item') as HTMLButtonElement;
      if (delBtn) {
        const id = delBtn.dataset.cartItemId;
        if (id) handleRemoveItem(id);
      }
    });

    const clearBtn = document.getElementById('btn-clear-cart');
    if (clearBtn) {
      clearBtn.addEventListener('click', clearCart);
    }

    window.addEventListener('storage', renderCart);
    window.addEventListener('cart-updated', renderCart);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>