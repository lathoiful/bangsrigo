--- 
// src/pages/konfirmasi.astro
import Layout from '../layouts/Layout.astro';
import { Icon } from "astro-icon/components";
---

<Layout>
  <!-- MAIN WRAPPER: Dibuat pas seukuran layar (h-screen) & matikan scroll luar (overflow-hidden) -->
  <main class="w-full max-w-md mx-auto bg-[#F8FAFC] relative flex flex-col h-screen overflow-hidden">
    
    <!-- ================= HEADER SECTION (TETAP DIAM DI ATAS) ================= -->
    <header class="bg-white border-b border-slate-200/80 px-4 h-14 flex items-center justify-between shadow-xs w-full flex-shrink-0 z-50">
      <a 
        href="/cart" 
        aria-label="Kembali ke keranjang" 
        class="w-9 h-9 flex items-center justify-center text-slate-700 hover:text-slate-900 bg-slate-100/80 hover:bg-slate-200/80 active:scale-95 rounded-full transition-all"
      >
        <Icon name="lucide:chevron-left" class="w-5 h-5 -ml-0.5" />
      </a>

      <div class="flex flex-col items-center justify-center text-center">
        <h1 class="text-sm font-bold text-slate-900 tracking-tight leading-tight">
          Konfirmasi Pesanan
        </h1>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[10px] font-medium text-slate-500">BangsriGo Order</span>
        </div>
      </div>

      <div class="w-9"></div> 
    </header>

    <!-- ================= MAIN CONTENT SECTION (HANYA INI YANG DI-SCROLL) ================= -->
    <div class="flex-1 w-full p-4 sm:p-5 space-y-4 overflow-y-auto pb-10">
      
      <!-- FORM DATA PEMESAN -->
      <section class="w-full bg-white rounded-2xl p-4 sm:p-5 border border-[#E5E7EB] shadow-xs space-y-4">
        <div class="flex items-center gap-2 pb-2.5 border-b border-slate-100">
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-[#0E9F3E] flex items-center justify-center">
            <Icon name="lucide:map-pin" class="w-4 h-4" />
          </div>
          <h2 class="text-sm font-bold text-[#111827]">
            Alamat Pengiriman
          </h2>
        </div>

        <div class="space-y-3.5">
          <!-- Nama Pemesan -->
          <div class="w-full">
            <label for="name" class="block text-[11px] font-semibold text-[#6B7280] mb-1">Nama Penerima <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="name"
              required
              autocomplete="name"
              placeholder="Contoh: Dimas"
              class="w-full border border-[#E5E7EB] rounded-xl px-3.5 py-3 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
            />
          </div>

          <!-- Grid Dukuh & RT -->
          <div class="grid grid-cols-2 gap-3 w-full">
            <div>
              <label for="dukuh" class="block text-[11px] font-semibold text-[#6B7280] mb-1">Dukuh <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="dukuh"
                required
                placeholder="Contoh: Banjarmelati"
                class="w-full border border-[#E5E7EB] rounded-xl px-3.5 py-3 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
              />
            </div>
            <div>
              <label for="rt" class="block text-[11px] font-semibold text-[#6B7280] mb-1">RT <span class="text-red-500">*</span></label>
              <input
                type="text"
                id="rt"
                required
                placeholder="Contoh: RT 01"
                class="w-full border border-[#E5E7EB] rounded-xl px-3.5 py-3 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
              />
            </div>
          </div>

          <!-- Detail Alamat / Kos -->
          <div class="w-full">
            <label for="address" class="block text-[11px] font-semibold text-[#6B7280] mb-1">Detail Tempat / Nama Kos <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="address"
              required
              autocomplete="street-address"
              placeholder="Contoh: Kos Bu Siti No. 4"
              class="w-full border border-[#E5E7EB] rounded-xl px-3.5 py-3 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
            />
          </div>

          <!-- Patokan -->
          <div class="w-full">
            <label for="landmark" class="block text-[11px] font-semibold text-[#6B7280] mb-1">Patokan (Opsional)</label>
            <input
              type="text"
              id="landmark"
              placeholder="Contoh: Depan warung Madura"
              class="w-full border border-[#E5E7EB] rounded-xl px-3.5 py-3 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
            />
          </div>

          <!-- Catatan Kurir -->
          <div class="w-full">
            <label for="note" class="block text-[11px] font-semibold text-[#6B7280] mb-1">Catatan Pengantaran (Opsional)</label>
            <textarea
              id="note"
              rows="2"
              placeholder="Contoh: Tolong taruh di teras depan"
              class="w-full border border-[#E5E7EB] rounded-xl p-3.5 text-xs sm:text-sm text-[#111827] focus:outline-none focus:border-[#0E9F3E] focus:ring-1 focus:ring-[#0E9F3E] resize-none placeholder:text-[#6B7280]/50 transition-all bg-slate-50/40"
            ></textarea>
          </div>
        </div>
      </section>

      <!-- RINGKASAN PESANAN -->
      <section class="w-full bg-white rounded-2xl p-4 sm:p-5 border border-[#E5E7EB] shadow-xs space-y-4">
        <div class="flex items-center gap-2 pb-2.5 border-b border-slate-100">
          <div class="w-7 h-7 rounded-lg bg-emerald-50 text-[#0E9F3E] flex items-center justify-center">
            <Icon name="lucide:receipt" class="w-4 h-4" />
          </div>
          <h3 class="text-sm font-bold text-[#111827]">
            Detail Belanjaan
          </h3>
        </div>

        <!-- Container Item Keranjang -->
        <div id="checkout-items-container" class="divide-y divide-slate-100 space-y-3">
          <!-- Render via JS -->
        </div>

        <div class="border-t border-[#E5E7EB] pt-3.5 space-y-2 text-xs sm:text-sm text-[#6B7280]">
          <div class="flex justify-between items-center">
            <span>Subtotal</span>
            <span id="checkout-subtotal" class="font-medium text-[#111827]">Rp 0</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="flex items-center gap-1.5">
              Ongkir 
              <span class="text-[9px] bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded font-medium border border-amber-200/50">Info WA</span>
            </span>
            <span class="font-medium text-[#111827]">Rp 0 - 5.000</span>
          </div>
        </div>

        <div class="border-t border-[#E5E7EB] pt-3.5 flex justify-between items-center">
          <span class="text-xs sm:text-sm font-bold text-[#111827]">Total Sementara</span>
          <span id="checkout-total" class="text-base sm:text-lg font-bold text-[#0E9F3E]">Rp 0</span>
        </div>
      </section>

      <!-- SECTION AKHIR (COMBINED INFO BANNER + TOMBOL WA) -->
      <section class="w-full bg-white rounded-2xl p-4 sm:p-5 border border-[#E5E7EB] shadow-xs space-y-3">
        
        <!-- Info Banner Hijau -->
        <div class="w-full bg-emerald-50/80 rounded-xl p-3.5 border border-emerald-100/80 flex gap-3 items-start">
          <div class="text-[#0E9F3E] mt-0.5 flex-shrink-0">
            <Icon name="lucide:info" class="w-4 h-4" />
          </div>
          <p class="text-[11px] sm:text-xs text-slate-700 leading-relaxed">
            Nanti pesanan otomatis dirangkum dan dikirim via WhatsApp ke admin setelah tombol di bawah ditekan.
          </p>
        </div>

        <!-- Tombol WhatsApp & Keterangan -->
        <div class="space-y-1.5 text-center pt-1">
          <button
            type="button"
            id="btn-whatsapp"
            class="w-full h-[50px] bg-[#25D366] hover:bg-[#20ba5a] active:scale-[0.98] text-white font-semibold rounded-xl flex items-center justify-center gap-2.5 shadow-sm transition-all cursor-pointer text-sm sm:text-base border-none"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Kirim Pesanan ke WhatsApp</span>
          </button>
          <span class="block text-[10px] text-[#6B7280]">Kamu bakal diarahkan langsung ke aplikasi WhatsApp.</span>
        </div>
      </section>

    </div>

  </main>
</Layout>

<script>
  interface AddonItem {
    name: string;
    price: number;
  }

  interface CartItem {
    cartItemId: string;
    id: string | number;
    menuId?: string | number;
    name: string;
    price: number;
    basePrice?: number;
    image: string;
    qty: number;
    quantity?: number;
    addons?: AddonItem[];
    notes?: string;
    spicyLevel?: string;
  }

  const STORAGE_KEY = 'bangsri_cart';
  const FORM_STORAGE_KEY = 'bangsri_checkout_form';
  const ADMIN_PHONE = '6285185032089';

  function formatRupiah(price: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    }).format(price).replace('Rp', 'Rp ');
  }

  function getCart(): CartItem[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function calculateItemTotal(item: CartItem): number {
    const qty = item.qty || item.quantity || 1;
    const base = item.price || item.basePrice || 0;
    const addonsTotal = (item.addons || []).reduce((sum, addon) => sum + addon.price, 0);
    return (base + addonsTotal) * qty;
  }

  function renderCheckoutSummary() {
    const container = document.getElementById('checkout-items-container');
    const subtotalEl = document.getElementById('checkout-subtotal');
    const totalEl = document.getElementById('checkout-total');

    if (!container || !subtotalEl || !totalEl) return;

    const cart = getCart();

    if (cart.length === 0) {
      container.innerHTML = `<p class="text-xs text-slate-500 py-2">Keranjang kosong. <a href="/cart" class="text-[#0E9F3E] underline font-medium">Kembali ke keranjang</a></p>`;
      subtotalEl.textContent = formatRupiah(0);
      totalEl.textContent = formatRupiah(0);
      return;
    }

    let subtotal = 0;

    container.innerHTML = cart.map(item => {
      const qty = item.qty || item.quantity || 1;
      const itemPrice = item.price || item.basePrice || 0;
      const itemTotal = calculateItemTotal(item);
      subtotal += itemTotal;

      let detailsHtml = '';
      if (item.spicyLevel) {
        detailsHtml += `<p class="text-[11px] text-[#6B7280]">Level ${item.spicyLevel}</p>`;
      }
      if (item.addons && item.addons.length > 0) {
        item.addons.forEach(addon => {
          detailsHtml += `<p class="text-[11px] text-[#6B7280]">+ ${addon.name}</p>`;
        });
      }
      if (!item.spicyLevel && (!item.addons || item.addons.length === 0)) {
        detailsHtml += `<p class="text-[11px] text-[#6B7280]">Tanpa Add-on</p>`;
      }

      return `
        <div class="pt-3 first:pt-0 flex justify-between items-start text-xs sm:text-sm">
          <div class="space-y-0.5">
            <p class="font-semibold text-[#111827]">${item.name}</p>
            ${detailsHtml}
            <p class="text-[11px] text-[#6B7280] pt-0.5">${qty}x @${formatRupiah(itemPrice)}</p>
          </div>
          <span class="font-medium text-[#111827]">
            ${formatRupiah(itemTotal)}
          </span>
        </div>
      `;
    }).join('');

    subtotalEl.textContent = formatRupiah(subtotal);
    totalEl.textContent = formatRupiah(subtotal);
  }

  function initFormStorage() {
    const fields = ['name', 'dukuh', 'rt', 'address', 'landmark', 'note'];
    
    try {
      const savedForm = localStorage.getItem(FORM_STORAGE_KEY);
      if (savedForm) {
        const formData = JSON.parse(savedForm);
        fields.forEach(fieldId => {
          const input = document.getElementById(fieldId) as HTMLInputElement | HTMLTextAreaElement;
          if (input && formData[fieldId]) {
            input.value = formData[fieldId];
          }
        });
      }
    } catch {}

    fields.forEach(fieldId => {
      const input = document.getElementById(fieldId);
      if (input) {
        input.addEventListener('input', () => {
          const formData: Record<string, string> = {};
          fields.forEach(id => {
            const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
            if (el) formData[id] = el.value;
          });
          localStorage.setItem(FORM_STORAGE_KEY, JSON.stringify(formData));
        });
      }
    });
  }

  function handleWhatsAppCheckout() {
    const cart = getCart();
    if (cart.length === 0) {
      alert('Keranjang belanjaan Anda masih kosong!');
      window.location.href = '/cart';
      return;
    }

    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const dukuh = (document.getElementById('dukuh') as HTMLInputElement)?.value.trim();
    const rt = (document.getElementById('rt') as HTMLInputElement)?.value.trim();
    const address = (document.getElementById('address') as HTMLInputElement)?.value.trim();
    const landmark = (document.getElementById('landmark') as HTMLInputElement)?.value.trim();
    const note = (document.getElementById('note') as HTMLTextAreaElement)?.value.trim();

    if (!name || !dukuh || !rt || !address) {
      alert('Mohon lengkapi data alamat pengiriman yang wajib diisi (*)!');
      document.getElementById('name')?.focus();
      return;
    }

    let subtotal = 0;
    let itemsText = cart.map((item, index) => {
      const qty = item.qty || item.quantity || 1;
      const itemTotal = calculateItemTotal(item);
      subtotal += itemTotal;

      let desc = `${index + 1}. *${item.name}* (x${qty})\n`;
      if (item.spicyLevel) desc += `    └ Level: ${item.spicyLevel}\n`;
      if (item.addons && item.addons.length > 0) {
        desc += `    └ Extra: ${item.addons.map(a => a.name).join(', ')}\n`;
      }
      desc += `    └ Harga: ${formatRupiah(itemTotal)}`;
      return desc;
    }).join('\n\n');

    const message = 
      `🛒 *PESANAN BARU*\n` +
      `──────────────────\n\n` +
      `👤 *DATA PENERIMA*\n` +
      `• *Nama:* ${name}\n` +
      `• *Dukuh:* ${dukuh}\n` +
      `• *RT/RW:* ${rt}\n` +
      `• *Alamat/Kos:* ${address}\n` +
      (landmark ? `• *Patokan:* ${landmark}\n` : '') +
      (note ? `• *Catatan:* ${note}\n` : '') +
      `\n` +
      `📦 *RINGKASAN PESANAN*\n\n` +
      `${itemsText}\n\n` +
      `──────────────────\n` +
      `💰 *RINGKASAN BIAYA*\n` +
      `• *Subtotal:* ${formatRupiah(subtotal)}\n` +
      `• *Ongkir:* Info WA (Rp 0 - 5.000)\n` +
      `• *Total Sementara:* *${formatRupiah(subtotal)}*\n` +
      `──────────────────\n\n` +
      `Mohon segera diproses ya kak, terima kasih! 🙏`;

    const encodedMessage = encodeURIComponent(message);
    const waUrl = `https://wa.me/${ADMIN_PHONE}?text=${encodedMessage}`;

    window.open(waUrl, '_blank');
  }

  function init() {
    renderCheckoutSummary();
    initFormStorage();

    const waButton = document.getElementById('btn-whatsapp');
    if (waButton) {
      waButton.addEventListener('click', handleWhatsAppCheckout);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>