---

<PlainLayout title="Mie Gacoan - BangsriGo">
  <!-- Wrapper Container Utama -->
  <div class="max-w-md mx-auto w-full min-h-screen bg-slate-50 flex flex-col relative pb-6 border-x border-slate-200/60 overflow-y-auto">
    
    <!-- TOAST NOTIFICATION -->
    <div 
      id="toast-notification" 
      class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-[90%] w-80 bg-slate-900/95 backdrop-blur-md text-white px-3.5 py-2.5 rounded-xl shadow-xl flex items-center justify-between gap-3 border border-slate-700/50 transition-all duration-300 transform -translate-y-16 opacity-0 pointer-events-none"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="min-w-0">
          <p id="toast-title" class="text-xs font-bold leading-tight truncate">Berhasil Ditambahkan</p>
          <p id="toast-message" class="text-[10px] text-slate-300 leading-tight truncate">Menu masuk ke keranjang</p>
        </div>
      </div>
      <button id="toast-close" type="button" class="text-slate-400 hover:text-white text-xs font-bold p-1 shrink-0">✕</button>
    </div>

    <!-- HEADER -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2.5">
          <a href="/jastip" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition-colors">
            <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <div>
            <h1 class="text-base font-extrabold text-slate-900 leading-tight">Mie Gacoan</h1>
            <p class="text-[11px] text-slate-400 font-medium">Bangsri & Sekitarnya</p>
          </div>
        </div>

        <!-- Keranjang Kanan Atas (Lebih Besar Tanpa Badge Jastip) -->
        <button 
          id="btn-header-cart" 
          type="button" 
          class="relative w-11 h-11 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center transition-all shadow-md shadow-emerald-600/20 active:scale-95"
          aria-label="Lihat Keranjang"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span 
            id="header-cart-badge" 
            class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[11px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white shadow-xs hidden"
          >
            0
          </span>
        </button>
      </div>

      <!-- FILTER KATEGORI TAB -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
        <button type="button" class="filter-tab active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900 text-white transition-all shrink-0" data-category="all">
          Semua
        </button>
        <button type="button" class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-category="mie">
          Mie
        </button>
        <button type="button" class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-category="dimsum">
          Dimsum
        </button>
        <button type="button" class="filter-tab px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-category="minuman">
          Minuman
        </button>
      </div>
    </header>

    <!-- KONTEN UTAMA MENU -->
    <main class="p-3.5 space-y-3 flex-1">
      
      <!-- MINI BANNER PROMO -->
      <div class="p-3.5 rounded-xl bg-slate-900 text-white flex items-center justify-between gap-2 shadow-xs">
        <div>
          <p class="text-xs font-bold">Pesan Jastip Gacoan</p>
          <p class="text-[10px] text-slate-400">Harga resmi outlet, diantar cepat & aman.</p>
        </div>
        <div class="w-8 h-8 rounded-lg bg-emerald-600/30 flex items-center justify-center shrink-0 border border-emerald-500/30">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
      </div>

      <!-- GRID CARDS MENU -->
      <div id="menu-grid" class="grid grid-cols-2 gap-2.5">
        {menuGacoan.map((item) => (
          <div 
            class="menu-card bg-white rounded-xl border border-slate-200/70 overflow-hidden flex flex-col justify-between"
            data-category={item.category}
            data-menu-id={item.id}
          >
            <div>
              <!-- FOTO MENU -->
              <div class="relative w-full aspect-4/3 bg-slate-100 overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-full object-cover" 
                  loading="lazy"
                />
                {item.badge && (
                  <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-slate-900/80 backdrop-blur-xs text-white text-[8px] font-medium">
                    {item.badge}
                  </span>
                )}
              </div>

              <!-- INFO MENU -->
              <div class="p-2.5">
                <h3 class="text-xs font-bold text-slate-900 leading-snug">{item.name}</h3>
                <p class="text-[10px] text-slate-400 mt-0.5 line-clamp-2 leading-relaxed">{item.desc}</p>
              </div>
            </div>

            <!-- HARGA & TOMBOL AKSI -->
            <div class="p-2.5 pt-0 flex items-center justify-between gap-1">
              <span class="text-xs font-bold text-slate-900">
                Rp {item.price.toLocaleString('id-ID')}
              </span>

              {item.needLevel ? (
                <button 
                  type="button"
                  class="btn-open-level px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[10px] font-bold rounded-lg transition-colors"
                  data-id={item.id}
                  data-name={item.name}
                  data-price={item.price}
                >
                  Pilih
                </button>
              ) : (
                <div class="card-action-container flex items-center" data-id={item.id}>
                  <!-- Tombol Tambah Pertama kali -->
                  <button 
                    type="button"
                    class="btn-add-simple btn-first-add w-6 h-6 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-lg flex items-center justify-center transition-colors"
                    data-id={item.id}
                    data-name={item.name}
                    data-price={item.price}
                  >
                    +
                  </button>

                  <!-- Kontrol - + di Card (Tampil jika qty > 0) -->
                  <div class="card-qty-control hidden items-center border border-slate-200 rounded-lg overflow-hidden bg-slate-50">
                    <button 
                      type="button" 
                      class="btn-card-minus px-1.5 py-0.5 text-slate-600 hover:bg-slate-200 text-xs font-bold"
                      data-id={item.id}
                    >-</button>
                    <span class="card-qty-count px-1.5 text-[11px] font-bold text-slate-900">0</span>
                    <button 
                      type="button" 
                      class="btn-card-plus px-1.5 py-0.5 text-slate-600 hover:bg-slate-200 text-xs font-bold"
                      data-id={item.id}
                      data-name={item.name}
                      data-price={item.price}
                    >+</button>
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

    </main>

    <!-- MODAL SELEKSI LEVEL PEDAS -->
    <div id="modal-level" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-2xs hidden flex items-end justify-center">
      <div class="w-full max-w-md bg-white rounded-t-2xl p-4 space-y-3.5 shadow-2xl">
        <div class="flex justify-between items-center border-b border-slate-100 pb-2">
          <div>
            <h3 id="modal-item-title" class="text-xs font-bold text-slate-900">Mie Gacoan</h3>
            <p class="text-[10px] text-slate-400">Pilih level pedas pesananmu</p>
          </div>
          <button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 text-xs font-bold p-1">✕</button>
        </div>

        <div class="space-y-1.5">
          <label class="block text-[11px] font-semibold text-slate-700">Tingkat Pedas</label>
          <div class="grid grid-cols-5 gap-1.5" id="level-options-container"></div>
        </div>

        <div class="space-y-1">
          <label for="modal-catatan" class="block text-[11px] font-semibold text-slate-700">Catatan (Opsional)</label>
          <input 
            type="text" 
            id="modal-catatan" 
            placeholder="Misal: Bawang goreng pisah" 
            class="w-full px-3 py-1.5 rounded-lg border border-slate-200 text-xs text-slate-800 focus:border-slate-900 focus:outline-none"
          />
        </div>

        <button 
          type="button" 
          id="btn-confirm-level"
          class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition-colors"
        >
          Tambah ke Keranjang
        </button>
      </div>
    </div>

    <!-- DRAWER / SLIDE-UP MODAL KERANJANG JASTIP -->
    <div id="drawer-cart" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-2xs hidden flex items-end justify-center">
      <div class="w-full max-w-md bg-white rounded-t-3xl max-h-[80vh] flex flex-col shadow-2xl">
        <!-- Header Cart Drawer -->
        <div class="p-4 border-b border-slate-100 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <h3 class="text-sm font-bold text-slate-900">Keranjang Jastip Gacoan</h3>
          </div>
          <button id="btn-close-cart" class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold text-xs hover:bg-slate-200">
            ✕
          </button>
        </div>

        <!-- List Item Keranjang -->
        <div id="cart-items-container" class="p-4 overflow-y-auto space-y-3 flex-1 divide-y divide-slate-100">
          <!-- Item diinjeksi via JavaScript -->
        </div>

        <!-- Footer Cart Drawer -->
        <div class="p-4 border-t border-slate-100 bg-slate-50 rounded-b-3xl space-y-3 shrink-0">
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-500 font-medium">Estimasi Subtotal</span>
            <span id="cart-total-price" class="font-black text-slate-900 text-sm">Rp 0</span>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button 
              id="btn-clear-cart" 
              type="button" 
              class="py-2.5 px-3 border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 font-bold text-xs rounded-xl transition-colors"
            >
              Kosongkan
            </button>
            <a 
              href="/jastip/keranjang" 
              class="py-2.5 px-3 bg-[#006E2E] hover:bg-emerald-800 text-white font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-1 text-center"
            >
              Lanjut Checkout
              <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  <script>
    const JASTIP_STORAGE_KEY = 'bangsri_jastip_cart';

    // Elements
    const filterTabs = document.querySelectorAll('.filter-tab');
    const menuCards = document.querySelectorAll('.menu-card');

    const modalLevel = document.getElementById('modal-level');
    const modalTitle = document.getElementById('modal-item-title');
    const modalCatatan = document.getElementById('modal-catatan') as HTMLInputElement;
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnConfirmLevel = document.getElementById('btn-confirm-level');
    const levelContainer = document.getElementById('level-options-container');

    const drawerCart = document.getElementById('drawer-cart');
    const btnHeaderCart = document.getElementById('btn-header-cart');
    const headerCartBadge = document.getElementById('header-cart-badge');
    const btnCloseCart = document.getElementById('btn-close-cart');
    const btnClearCart = document.getElementById('btn-clear-cart');
    const cartItemsContainer = document.getElementById('cart-items-container');
    const cartTotalPrice = document.getElementById('cart-total-price');

    // Toast Elements
    const toastNotification = document.getElementById('toast-notification');
    const toastTitle = document.getElementById('toast-title');
    const toastMessage = document.getElementById('toast-message');
    const toastClose = document.getElementById('toast-close');
    let toastTimeout: any = null;

    let currentSelectedItem: { id: string; name: string; price: number } | null = null;
    let selectedLevel = '0';

    // --- HELPER FUNCTION: TOAST NOTIFICATION ---
    function showToast(title: string, message: string) {
      if (!toastNotification || !toastTitle || !toastMessage) return;

      toastTitle.textContent = title;
      toastMessage.textContent = message;

      if (toastTimeout) clearTimeout(toastTimeout);

      toastNotification.classList.remove('-translate-y-16', 'opacity-0', 'pointer-events-none');
      toastNotification.classList.add('translate-y-0', 'opacity-100');

      toastTimeout = setTimeout(() => {
        hideToast();
      }, 2500);
    }

    function hideToast() {
      if (!toastNotification) return;
      toastNotification.classList.remove('translate-y-0', 'opacity-100');
      toastNotification.classList.add('-translate-y-16', 'opacity-0', 'pointer-events-none');
    }

    toastClose?.addEventListener('click', hideToast);

    // 1. Filter Kategori Tab
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.getAttribute('data-category');

        filterTabs.forEach((t) => {
          t.classList.remove('bg-slate-900', 'text-white');
          t.classList.add('bg-slate-100', 'text-slate-600');
        });
        tab.classList.remove('bg-slate-100', 'text-slate-600');
        tab.classList.add('bg-slate-900', 'text-white');

        menuCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'all' || cardCat === category) {
            (card as HTMLElement).classList.remove('hidden');
            (card as HTMLElement).classList.add('flex');
          } else {
            (card as HTMLElement).classList.remove('flex');
            (card as HTMLElement).classList.add('hidden');
          }
        });
      });
    });

    // 2. Helper LocalStorage Cart Operations
    function getCartItems(): any[] {
      try {
        const raw = localStorage.getItem(JASTIP_STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveCartItems(items: any[]) {
      localStorage.setItem(JASTIP_STORAGE_KEY, JSON.stringify(items));
      window.dispatchEvent(new Event('jastip-cart-updated'));
      updateCartUI();
    }

    function addOrUpdateCartItem(menuId: string, name: string, price: number, catatan: string = 'Original') {
      const items = getCartItems();
      const existingIndex = items.findIndex(item => item.menuId === menuId && item.catatan === catatan);

      if (existingIndex > -1) {
        items[existingIndex].jumlah = (items[existingIndex].jumlah || 1) + 1;
      } else {
        items.push({
          id: `${menuId}-${Date.now()}`,
          menuId: menuId,
          jenis: 'Jastip Gacoan',
          nama: name,
          harga: price,
          deskripsi: `Rp ${price.toLocaleString('id-ID')}`,
          jumlah: 1,
          catatan: catatan
        });
      }

      saveCartItems(items);
    }

    // 3. Render & Sync UI Keranjang & Card Controls
    function updateCartUI() {
      const items = getCartItems();
      const totalQty = items.reduce((sum, item) => sum + (item.jumlah || item.qty || 1), 0);

      // Update Badge Keranjang Header Kanan Atas
      if (headerCartBadge) {
        if (totalQty > 0) {
          headerCartBadge.textContent = totalQty.toString();
          headerCartBadge.classList.remove('hidden');
        } else {
          headerCartBadge.classList.add('hidden');
        }
      }

      // Sync Kontrol Qty (- / +) pada setiap Card Menu Sederhana
      document.querySelectorAll('.card-action-container').forEach((container) => {
        const menuId = container.getAttribute('data-id');
        const firstAddBtn = container.querySelector('.btn-first-add');
        const qtyControl = container.querySelector('.card-qty-control');
        const qtyCount = container.querySelector('.card-qty-count');

        const itemQty = items
          .filter(i => i.menuId === menuId || i.id?.startsWith(`${menuId}-`))
          .reduce((sum, i) => sum + (i.jumlah || i.qty || 1), 0);

        if (itemQty > 0) {
          firstAddBtn?.classList.add('hidden');
          qtyControl?.classList.remove('hidden');
          qtyControl?.classList.add('flex');
          if (qtyCount) qtyCount.textContent = itemQty.toString();
        } else {
          firstAddBtn?.classList.remove('hidden');
          qtyControl?.classList.add('hidden');
          qtyControl?.classList.remove('flex');
        }
      });

      // Render item di dalam Drawer Keranjang
      if (!cartItemsContainer) return;

      if (items.length === 0) {
        cartItemsContainer.innerHTML = `
          <div class="py-10 text-center text-slate-400">
            <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <p class="text-xs font-semibold">Keranjang Masih Kosong</p>
            <p class="text-[10px] mt-0.5">Pilih menu Gacoan favoritmu di atas</p>
          </div>
        `;
        if (cartTotalPrice) cartTotalPrice.textContent = 'Rp 0';
        return;
      }

      let subtotal = 0;
      cartItemsContainer.innerHTML = items.map((item, idx) => {
        const numPrice = parseInt((item.harga || item.deskripsi || '0').toString().replace(/[^0-9]/g, '')) || 0;
        const qty = item.jumlah || item.qty || 1;
        subtotal += numPrice * qty;

        return `
          <div class="pt-2.5 first:pt-0 flex items-center justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold text-slate-900 truncate">${item.nama || 'Menu Gacoan'}</h4>
              <p class="text-[10px] text-emerald-700 font-semibold">${item.catatan || 'Tanpa catatan'}</p>
              <p class="text-[11px] font-medium text-slate-500 mt-0.5">Rp ${numPrice.toLocaleString('id-ID')}</p>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <div class="flex items-center border border-slate-200 rounded-lg overflow-hidden bg-slate-50">
                <button type="button" class="btn-qty-minus px-2 py-1 text-slate-600 hover:bg-slate-200 text-xs font-bold" data-index="${idx}">-</button>
                <span class="px-2 text-xs font-bold text-slate-800">${qty}</span>
                <button type="button" class="btn-qty-plus px-2 py-1 text-slate-600 hover:bg-slate-200 text-xs font-bold" data-index="${idx}">+</button>
              </div>

              <button type="button" class="btn-remove-item text-slate-400 hover:text-red-500 p-1 transition-colors" data-index="${idx}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join('');

      if (cartTotalPrice) {
        cartTotalPrice.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
      }

      // Attach Listener untuk tombol di dalam Drawer
      document.querySelectorAll('.btn-qty-plus').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLButtonElement).getAttribute('data-index'));
          const currentItems = getCartItems();
          currentItems[idx].jumlah = (currentItems[idx].jumlah || 1) + 1;
          saveCartItems(currentItems);
        });
      });

      document.querySelectorAll('.btn-qty-minus').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLButtonElement).getAttribute('data-index'));
          const currentItems = getCartItems();
          if ((currentItems[idx].jumlah || 1) > 1) {
            currentItems[idx].jumlah -= 1;
          } else {
            currentItems.splice(idx, 1);
          }
          saveCartItems(currentItems);
        });
      });

      document.querySelectorAll('.btn-remove-item').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLButtonElement).getAttribute('data-index'));
          const currentItems = getCartItems();
          currentItems.splice(idx, 1);
          saveCartItems(currentItems);
        });
      });
    }

    // 4. Handler Tambah Pertama Kali pada Card
    document.querySelectorAll('.btn-add-simple').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const id = button.getAttribute('data-id') || '';
        const name = button.getAttribute('data-name') || 'Menu';
        const price = Number(button.getAttribute('data-price') || 0);

        addOrUpdateCartItem(id, name, price, 'Original');
        showToast('Berhasil Ditambahkan!', `${name} masuk keranjang.`);
      });
    });

    // Handler Tombol (+) pada Card langsung
    document.querySelectorAll('.btn-card-plus').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const id = button.getAttribute('data-id') || '';
        const name = button.getAttribute('data-name') || 'Menu';
        const price = Number(button.getAttribute('data-price') || 0);

        addOrUpdateCartItem(id, name, price, 'Original');
      });
    });

    // Handler Tombol (-) pada Card langsung
    document.querySelectorAll('.btn-card-minus').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const menuId = button.getAttribute('data-id') || '';

        const items = getCartItems();
        const idx = items.map(i => i.menuId || i.id?.split('-')[0]).lastIndexOf(menuId);

        if (idx > -1) {
          if ((items[idx].jumlah || 1) > 1) {
            items[idx].jumlah -= 1;
          } else {
            items.splice(idx, 1);
          }
          saveCartItems(items);
        }
      });
    });

    // 5. Modal Level Pedas
    document.querySelectorAll('.btn-open-level').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const id = button.getAttribute('data-id') || '';
        const name = button.getAttribute('data-name') || '';
        const price = Number(button.getAttribute('data-price') || 0);

        currentSelectedItem = { id, name, price };
        if (modalTitle) modalTitle.textContent = name;

        if (levelContainer) {
          const isExtreme = name.includes('6-8');
          const levels = isExtreme ? ['6', '7', '8'] : ['0', '1', '2', '3', '4'];
          selectedLevel = levels[0];

          levelContainer.innerHTML = levels.map((lvl) => `
            <button 
              type="button" 
              class="lvl-opt-btn py-1.5 rounded-lg border text-xs font-bold transition-all ${lvl === selectedLevel ? 'bg-slate-900 text-white border-slate-900' : 'bg-slate-50 text-slate-700 border-slate-200'}"
              data-lvl="${lvl}"
            >
              Lvl ${lvl}
            </button>
          `).join('');

          document.querySelectorAll('.lvl-opt-btn').forEach((lvlBtn) => {
            lvlBtn.addEventListener('click', (evt) => {
              document.querySelectorAll('.lvl-opt-btn').forEach((b) => {
                b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
                b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200');
              });
              const target = evt.currentTarget as HTMLButtonElement;
              selectedLevel = target.getAttribute('data-lvl') || '0';
              target.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200');
              target.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
            });
          });
        }

        modalLevel?.classList.remove('hidden');
      });
    });

    btnCloseModal?.addEventListener('click', () => modalLevel?.classList.add('hidden'));

    // Konfirmasi Level Pedas (+ TOAST)
    btnConfirmLevel?.addEventListener('click', () => {
      if (!currentSelectedItem) return;

      const catatanVal = modalCatatan?.value?.trim();
      const finalCatatan = `Level ${selectedLevel}${catatanVal ? ` (${catatanVal})` : ''}`;

      addOrUpdateCartItem(
        currentSelectedItem.id, 
        currentSelectedItem.name, 
        currentSelectedItem.price, 
        finalCatatan
      );

      showToast('Berhasil Ditambahkan!', `${currentSelectedItem.name} (${finalCatatan}) masuk keranjang.`);

      modalLevel?.classList.add('hidden');
      if (modalCatatan) modalCatatan.value = '';
    });

    // 6. Controller Drawer Keranjang
    btnHeaderCart?.addEventListener('click', () => {
      updateCartUI();
      drawerCart?.classList.remove('hidden');
    });

    btnCloseCart?.addEventListener('click', () => {
      drawerCart?.classList.add('hidden');
    });

    btnClearCart?.addEventListener('click', () => {
      saveCartItems([]);
      showToast('Keranjang Dikosongkan', 'Semua item pesanan telah dihapus.');
    });

    // Inisialisasi awal UI
    updateCartUI();
  </script>
</PlainLayout>