---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

interface Addon {
  name: string;
  price: number;
  checked?: boolean;
}

const { slug } = Astro.params;

// Fetch data menu dari Supabase berdasarkan slug
const { data: menu, error } = await supabase
  .from('menus')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !menu) {
  return Astro.redirect('/404');
}

// 1. Konversi price dari string ke number
const menuPrice = Number(menu.price) || 0;

// 2. Safely parse JSON addons
let addons: Addon[] = [];
try {
  addons = typeof menu.addons === 'string' ? JSON.parse(menu.addons) : (menu.addons || []);
} catch (e) {
  addons = [];
}

// 3. Safely parse JSON spice_levels
let rawSpiceLevels: number[] = [];
try {
  rawSpiceLevels = typeof menu.spice_levels === 'string' ? JSON.parse(menu.spice_levels) : (menu.spice_levels || []);
} catch (e) {
  rawSpiceLevels = [];
}

// Format daftar level pedas berdasarkan isi DB
const spicyLevels = rawSpiceLevels.map((lvl, index) => ({
  id: lvl,
  label: String(lvl),
  // Default aktif di level terendah jika ada
  active: index === 0
}));

const formatRupiah = (price: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(price).replace('Rp', 'Rp ');
};
---

<Layout>
  <main class="w-full max-w-md mx-auto bg-slate-50 relative flex flex-col h-full overflow-y-auto no-scrollbar">
    
    <!-- HEADER FOTO MENU -->
    <div class="relative w-full h-[320px] shrink-0">
      <img 
        src={menu.image} 
        alt={menu.name} 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

      <!-- TOMBOL BACK & CART -->
      <div class="absolute top-4 left-0 right-0 px-6 flex items-center justify-between z-20">
        <a href="/" class="w-10 h-10 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center text-slate-800 shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:bg-white active:scale-95 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>

        <!-- TOMBOL KERANJANG (MENGARAH KE /cart) -->
        <a href="/cart" class="w-10 h-10 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center text-slate-800 shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:bg-white active:scale-95 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- KONTEN UTAMA DETAIL MENU -->
    <div class="relative z-10 flex-1 w-full bg-white -mt-8 rounded-t-[32px] px-6 pt-8 pb-10 shadow-[0_-8px_24px_rgba(0,0,0,0.06)] flex flex-col gap-8">
      
      <!-- Informasi Menu -->
      <div>
        <div class="flex items-start justify-between gap-4">
          <h1 class="text-[26px] font-bold text-slate-900 leading-tight">{menu.name}</h1>
          {menu.badge && (
            <span class="shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-[#16A34A] bg-green-50 px-2 py-1 rounded-md uppercase tracking-wider">
              🔥 {menu.badge}
            </span>
          )}
        </div>
        
        <p class="text-[14px] text-slate-500 font-medium mt-2 leading-relaxed">
          {menu.description} 
          {menu.subdescription && <span class="block mt-0.5 text-slate-600">{menu.subdescription}</span>}
        </p>

        <div class="text-2xl font-bold text-[#16A34A] mt-4">
          {formatRupiah(menuPrice)}
        </div>
      </div>

      <!-- LEVEL PEDAS -->
      {spicyLevels.length > 0 && (
        <section>
          <h2 class="text-[17px] font-bold text-slate-900 mb-4">Level Pedas</h2>
          <div class="flex flex-wrap gap-3" id="spicy-container">
            {spicyLevels.map((lvl) => (
              <button 
                type="button"
                data-level={lvl.label}
                class={`spicy-btn h-10 px-5 rounded-full text-[13px] font-bold transition-all active:scale-95 border cursor-pointer ${
                  lvl.active 
                    ? 'bg-[#16A34A] text-white border-[#16A34A] shadow-md shadow-green-600/20 active-spicy' 
                    : 'bg-white text-slate-600 border-slate-200 hover:border-slate-300 hover:bg-slate-50'
                }`}
              >
                Level {lvl.label}
              </button>
            ))}
          </div>
        </section>
      )}

      <!-- ADD-ON -->
      {addons.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-[17px] font-bold text-slate-900">Pilihan Tambahan</h2>
            <span class="text-xs text-slate-400 font-medium bg-slate-50 px-2 py-1 rounded-md border border-slate-100">Opsional</span>
          </div>
          
          <div class="space-y-3">
            {addons.map((addon) => (
              <label class="flex items-center justify-between p-4 bg-white border border-slate-200 rounded-2xl cursor-pointer hover:border-[#16A34A] transition-colors shadow-sm group">
                <div class="flex flex-col gap-1">
                  <span class="text-[15px] font-bold text-slate-800">{addon.name}</span>
                  <span class="text-[13px] text-slate-500 font-medium">Ekstra topping</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-[14px] font-bold text-slate-900">+{formatRupiah(addon.price)}</span>
                  <div class="relative flex items-center justify-center">
                    <input 
                      type="checkbox" 
                      data-name={addon.name}
                      data-price={addon.price}
                      checked={addon.checked || false}
                      class="addon-checkbox peer appearance-none w-6 h-6 border-2 border-slate-300 rounded-full checked:border-[#16A34A] checked:bg-[#16A34A] transition-colors cursor-pointer"
                    />
                    <svg class="absolute w-3.5 h-3.5 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </section>
      )}

      <!-- CATATAN -->
      <section>
        <h2 class="text-[17px] font-bold text-slate-900 mb-4">Catatan untuk Resto</h2>
        <textarea 
          id="notes-input"
          class="w-full min-h-[90px] bg-white border border-slate-200 rounded-2xl p-4 text-[14px] font-medium text-slate-700 placeholder-slate-400 focus:outline-none focus:border-[#16A34A] focus:ring-1 focus:ring-[#16A34A] transition shadow-sm resize-none"
          placeholder="Contoh: Sambal dipisah, tidak pakai timun..."
        ></textarea>
      </section>

      <!-- JUMLAH -->
      <section class="flex items-center justify-between pt-2">
        <h2 class="text-[17px] font-bold text-slate-900">Jumlah</h2>
        <div class="flex items-center gap-4">
          <button id="btn-minus" type="button" class="w-10 h-10 rounded-full bg-white border border-slate-200 text-slate-400 flex items-center justify-center hover:bg-slate-50 transition active:scale-90 shadow-sm cursor-pointer">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
          </button>
          <span id="quantity-label" class="text-[17px] font-bold text-slate-900 min-w-[24px] text-center">1</span>
          <button id="btn-plus" type="button" class="w-10 h-10 rounded-full bg-[#16A34A] text-white flex items-center justify-center hover:bg-green-700 transition active:scale-90 shadow-sm cursor-pointer shadow-green-600/30">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          </button>
        </div>
      </section>
      
    </div>

    <!-- STICKY BOTTOM BAR ACTION -->
    <div class="sticky bottom-0 z-50 w-full bg-white border-t border-slate-100 px-6 py-4 pb-8 sm:pb-6 shadow-[0_-12px_24px_rgba(0,0,0,0.06)] shrink-0">
      <div class="flex items-center justify-between gap-6">
        <div class="flex flex-col">
          <span class="text-[12px] font-medium text-slate-500 mb-0.5">Total Harga</span>
          <span id="total-price-label" class="text-[20px] font-bold text-slate-900 leading-none">{formatRupiah(menuPrice)}</span>
        </div>
        
        <button id="add-to-cart-btn" class="flex-1 h-[52px] bg-[#16A34A] text-white rounded-xl font-bold text-[15px] hover:bg-green-700 transition active:scale-[0.98] flex items-center justify-center shadow-lg shadow-green-600/20 cursor-pointer">
          Tambah ke Keranjang
        </button>
      </div>
    </div>

  </main>
</Layout>

<!-- SCRIPT CLIENT INTERAKSI -->
<script is:inline define:vars={{ menuId: menu.id, menuName: menu.name, basePrice: menuPrice, menuImage: menu.image, initialSpicy: spicyLevels[0]?.label || null }}>
  let quantity = 1;
  let selectedSpicyLevel = initialSpicy;
  const STORAGE_KEY = 'bangsri_cart';

  const totalPriceLabel = document.getElementById('total-price-label');
  const quantityLabel = document.getElementById('quantity-label');
  const btnMinus = document.getElementById('btn-minus');
  const btnPlus = document.getElementById('btn-plus');
  const spicyBtns = document.querySelectorAll('.spicy-btn');
  const addonCheckboxes = document.querySelectorAll('.addon-checkbox');
  const notesInput = document.getElementById('notes-input');
  const addToCartBtn = document.getElementById('add-to-cart-btn');

  const formatRupiahJS = (price) => {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    }).format(price).replace('Rp', 'Rp ');
  };

  function calculateTotal() {
    let addonPriceSum = 0;
    addonCheckboxes.forEach((cb) => {
      if (cb.checked) {
        addonPriceSum += Number(cb.dataset.price || 0);
      }
    });

    const total = (basePrice + addonPriceSum) * quantity;
    if (totalPriceLabel) {
      totalPriceLabel.textContent = formatRupiahJS(total);
    }
    return { total, addonPriceSum };
  }

  btnPlus?.addEventListener('click', () => {
    quantity++;
    if (quantityLabel) quantityLabel.textContent = quantity;
    calculateTotal();
  });

  btnMinus?.addEventListener('click', () => {
    if (quantity > 1) {
      quantity--;
      if (quantityLabel) quantityLabel.textContent = quantity;
      calculateTotal();
    }
  });

  addonCheckboxes.forEach((cb) => {
    cb.addEventListener('change', calculateTotal);
  });

  spicyBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Reset semua tombol ke style default (tidak aktif)
      spicyBtns.forEach((b) => {
        b.classList.remove('bg-[#16A34A]', 'text-white', 'border-[#16A34A]', 'shadow-md', 'shadow-green-600/20', 'active-spicy');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      });

      // Aktifkan tombol yang diklik
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.classList.add('bg-[#16A34A]', 'text-white', 'border-[#16A34A]', 'shadow-md', 'shadow-green-600/20', 'active-spicy');
      
      selectedSpicyLevel = btn.dataset.level || null;
    });
  });

  function isSameAddons(addonsA = [], addonsB = []) {
    if (addonsA.length !== addonsB.length) return false;
    const namesA = addonsA.map(a => a.name).sort();
    const namesB = addonsB.map(b => b.name).sort();
    return namesA.every((val, index) => val === namesB[index]);
  }

  addToCartBtn?.addEventListener('click', () => {
    const selectedAddons = [];
    addonCheckboxes.forEach((cb) => {
      if (cb.checked) {
        selectedAddons.push({
          name: cb.dataset.name,
          price: Number(cb.dataset.price || 0)
        });
      }
    });

    const notes = notesInput ? notesInput.value.trim() : '';
    const existingCart = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');

    const existingIndex = existingCart.findIndex((item) => {
      const itemId = item.id || item.menuId;
      const sameId = String(itemId) === String(menuId);
      const sameSpicy = String(item.spicyLevel || '') === String(selectedSpicyLevel || '');
      const sameNotes = (item.notes || '') === notes;
      const sameAddons = isSameAddons(item.addons || [], selectedAddons);

      return sameId && sameSpicy && sameNotes && sameAddons;
    });

    if (existingIndex > -1) {
      const currentQty = existingCart[existingIndex].qty || existingCart[existingIndex].quantity || 1;
      const updatedQty = currentQty + quantity;
      existingCart[existingIndex].qty = updatedQty;
      existingCart[existingIndex].quantity = updatedQty;
    } else {
      existingCart.push({
        cartItemId: `${menuId}_${Date.now()}`,
        id: menuId,
        menuId: menuId,
        name: menuName,
        price: basePrice,
        basePrice: basePrice,
        image: menuImage,
        spicyLevel: selectedSpicyLevel,
        addons: selectedAddons,
        notes: notes,
        qty: quantity,
        quantity: quantity
      });
    }

    localStorage.setItem(STORAGE_KEY, JSON.stringify(existingCart));
    window.dispatchEvent(new Event('cart-updated'));

    const originalText = addToCartBtn.textContent;
    addToCartBtn.textContent = '✓ Masuk Keranjang!';
    addToCartBtn.classList.remove('bg-[#16A34A]', 'hover:bg-green-700');
    addToCartBtn.classList.add('bg-slate-900', 'hover:bg-slate-800');

    setTimeout(() => {
      addToCartBtn.textContent = originalText;
      addToCartBtn.classList.remove('bg-slate-900', 'hover:bg-slate-800');
      addToCartBtn.classList.add('bg-[#16A34A]', 'hover:bg-green-700');
    }, 1500);
  });
</script>