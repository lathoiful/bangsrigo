---
// src/layouts/Layout.astro
import logo from '../assets/logo.svg';

interface Props {
  title?: string;
  activeTab?: 'beranda' | 'menu' | 'jastip' | 'titipan' | 'keranjang';
  hideHeader?: boolean;
}

const { 
  title = 'BangsriGo - Pemesanan Makanan Warung', 
  activeTab = 'beranda',
  hideHeader = false 
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-100 sm:bg-slate-200 text-slate-800 flex items-center justify-center min-h-[100dvh] sm:p-4 antialiased">

    <!-- APP CONTAINER MOCKUP -->
    <div class="w-full max-w-md h-[100dvh] sm:h-[844px] bg-[#F8F8F8] sm:rounded-3xl sm:shadow-2xl sm:border border-slate-300/60 overflow-y-auto no-scrollbar flex flex-col relative pb-20">
      
      <!-- HEADER -->
      {!hideHeader && (
        <header class="bg-white px-5 py-5 border-b border-slate-100 flex items-center justify-between sticky top-0 z-30 shadow-xs">
          <div class="flex items-center gap-2">
            <a href="/">
              <img src={logo.src} alt="BangsriGo Logo" class="h-14 w-auto object-contain" />
            </a>
          </div>

          <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full text-xs font-semibold">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Bangsri & Sekitarnya
          </div>
        </header>
      )}

      <!-- KONTEN HALAMAN (SLOT) -->
      <slot />

      <!-- FLOATING BOTTOM NAVIGATION BAR -->
      <nav class="fixed sm:absolute bottom-2 left-1/2 -translate-x-1/2 w-[94%] max-w-[400px] bg-white/95 backdrop-blur-md rounded-[24px] shadow-lg border border-slate-100 px-2 py-1.5 z-50 flex items-center justify-between">
        
        <!-- 1. Beranda -->
        <a 
          href="/" 
          class={`flex flex-col items-center gap-0.5 flex-1 transition-colors ${
            activeTab === 'beranda' ? 'text-[#16A34A]' : 'text-slate-400 hover:text-slate-600'
          }`}
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
          </svg>
          <span class="text-[10px] font-semibold tracking-wide">Beranda</span>
        </a>

        <!-- 2. Menu Makanan -->
        <a 
          href="/menu" 
          class={`flex flex-col items-center gap-0.5 flex-1 transition-colors ${
            activeTab === 'menu' ? 'text-[#16A34A]' : 'text-slate-400 hover:text-slate-600'
          }`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="text-[10px] font-semibold tracking-wide">Menu</span>
        </a>

        <!-- 3. Jastip -->
        <a 
          href="/jastip" 
          class={`flex flex-col items-center gap-0.5 flex-1 transition-colors ${
            activeTab === 'jastip' ? 'text-[#16A34A]' : 'text-slate-400 hover:text-slate-600'
          }`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="text-[10px] font-semibold tracking-wide">Jastip</span>
        </a>

        <!-- 4. Titipan -->
        <a 
          href="/jastip/keranjang" 
          class={`relative flex flex-col items-center flex-1 transition-colors ${
            activeTab === 'titipan' ? 'text-[#16A34A]' : 'text-slate-600 hover:text-slate-800'
          }`}
        >
          <div class="relative -mt-4 mb-0.5">
            <div class={`w-9 h-9 rounded-full flex items-center justify-center text-white shadow-md ring-4 ring-white active:scale-95 transition-transform ${
              activeTab === 'titipan' ? 'bg-[#16A34A] shadow-emerald-900/30' : 'bg-slate-700 shadow-slate-900/20'
            }`}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>

              <span 
                id="layout-titipan-badge" 
                class="absolute -top-1 -right-1 bg-amber-500 text-white text-[9px] font-bold min-w-[17px] h-[17px] px-1 rounded-full flex items-center justify-center border-2 border-white shadow-xs hidden"
              >
                0
              </span>
            </div>
          </div>
          <span class="text-[10px] font-semibold tracking-wide">Titipan</span>
        </a>

        <!-- 5. Keranjang -->
        <a 
          href="/cart" 
          class={`relative flex flex-col items-center flex-1 transition-colors ${
            activeTab === 'keranjang' ? 'text-[#16A34A]' : 'text-slate-600 hover:text-slate-800'
          }`}
        >
          <div class="relative -mt-4 mb-0.5">
            <div class={`w-9 h-9 rounded-full flex items-center justify-center text-white shadow-md ring-4 ring-white active:scale-95 transition-transform ${
              activeTab === 'keranjang' ? 'bg-[#16A34A] shadow-emerald-900/30' : 'bg-[#006E2E] shadow-emerald-900/30'
            }`}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 000-4z" />
              </svg>

              <span 
                id="layout-cart-badge" 
                class="absolute -top-1 -right-1 bg-red-500 text-white text-[9px] font-bold min-w-[17px] h-[17px] px-1 rounded-full flex items-center justify-center border-2 border-white shadow-xs hidden"
              >
                0
              </span>
            </div>
          </div>
          <span class="text-[10px] font-semibold tracking-wide">Keranjang</span>
        </a>

      </nav>

    </div>

  </body>
</html>

<script>
  const CART_KEY = 'bangsri_cart';
  const JASTIP_CART_KEY = 'bangsri_jastip_cart';

  function updateLayoutBadges() {
    const mainBadge = document.getElementById('layout-cart-badge');
    const titipanBadge = document.getElementById('layout-titipan-badge');

    try {
      const cartData = localStorage.getItem(CART_KEY);
      const cart = cartData ? JSON.parse(cartData) : [];
      const totalCartQty = cart.reduce((sum: number, item: any) => sum + (item.qty || item.quantity || 1), 0);

      if (mainBadge) {
        if (totalCartQty > 0) {
          mainBadge.classList.remove('hidden');
          mainBadge.textContent = totalCartQty > 99 ? '99+' : totalCartQty.toString();
        } else {
          mainBadge.classList.add('hidden');
        }
      }

      const jastipData = localStorage.getItem(JASTIP_CART_KEY);
      const jastipCart = jastipData ? JSON.parse(jastipData) : [];
      const totalJastipQty = jastipCart.reduce((sum: number, item: any) => sum + (item.jumlah || item.qty || 1), 0);

      if (titipanBadge) {
        if (totalJastipQty > 0) {
          titipanBadge.classList.remove('hidden');
          titipanBadge.textContent = totalJastipQty > 99 ? '99+' : totalJastipQty.toString();
        } else {
          titipanBadge.classList.add('hidden');
        }
      }
    } catch {
      if (mainBadge) mainBadge.classList.add('hidden');
      if (titipanBadge) titipanBadge.classList.add('hidden');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateLayoutBadges);
  } else {
    updateLayoutBadges();
  }

  window.addEventListener('storage', updateLayoutBadges);
  window.addEventListener('cart-updated', updateLayoutBadges);
</script>

<style is:global>
  @import "tailwindcss";

  body {
    font-family: 'Inter', sans-serif;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>