---
// src/layouts/Layout.astro
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>BangsriGo - Pemesanan Makanan Warung</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-100 text-slate-800 flex items-center justify-center min-h-screen sm:p-6 antialiased">

    <!-- CONTAINER CONTAINER MOCKUP SIMPEL -->
    <div class="w-full max-w-[430px] h-screen sm:h-[844px] bg-[#F8F8F8] sm:rounded-3xl sm:shadow-xl sm:border border-slate-200 overflow-hidden overflow-y-auto no-scrollbar flex flex-col">
      
      <!-- KONTEN HALAMAN (SLOT) -->
      <slot />

    </div>

  </body>
</html>

<style is:global>
  @import "tailwindcss";

  body {
    font-family: 'Inter', sans-serif;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>